# Never run dependency lifecycle scripts, even on a bare `npm install`.
ignore-scripts=true
# Don't resolve versions published in the last 7 days; most malicious releases are
# caught and pulled within that window. To take an urgent fix sooner, pass
# --min-release-age=0 for that one update (also needed for `npm audit signatures`
# while the lockfile holds a version younger than this).
min-release-age=7
